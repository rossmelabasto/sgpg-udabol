# Firebase (cuenta de servicio del Admin SDK). En Vercel se cargan como variables
# de entorno; aquí, para desarrollo contra el proyecto real.
FIREBASE_PROJECT_ID=udabol-project-manager
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@udabol-project-manager.iam.gserviceaccount.com
# La clave privada en una sola línea, con los saltos como \n y entre comillas.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Groq (extracción de datos de los PDFs con IA). Opcional: sin clave se usa solo la heurística.
GROQ_API_KEY=
