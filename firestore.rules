rules_version = '2';

// SGPG no usa Firestore desde el navegador: todo pasa por el servidor
// (Next.js + Firebase Admin SDK, que no está sujeto a estas reglas) y ahí se
// verifica la sesión y el rol. Por eso se niega cualquier acceso directo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
